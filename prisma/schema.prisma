generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── NextAuth required models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App models ────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  password       String?       @db.Text
  role           Role          @default(SUBSCRIBER)
  vip            Boolean       @default(false)
  bio            String?       @db.Text
  motivation     String?       @db.Text
  onboarded          Boolean          @default(false)
  emailNotifications Boolean          @default(true)
  suspended          Boolean          @default(false)
  tokenVersion       Int              @default(0)
  authorStatus       AuthorStatus?
  sanityAuthorId     String?
  accounts           Account[]
  sessions           Session[]
  follows            Follow[]
  readingHistory     ReadingHistory[]
  likes              Like[]
  bookmarks          Bookmark[]
  comments           Comment[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  cv                  AuthorCV?
  apiKey              AuthorApiKey?
  guideCompletions    GuideCompletion[]
  tokenUsages         TokenUsage[]
  createdAt          DateTime         @default(now())
}

model Follow {
  id       String @id @default(cuid())
  userId   String
  type     String
  sanityId String
  name     String?
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sanityId])
}

model ReadingHistory {
  id           String   @id @default(cuid())
  userId       String
  postSlug     String
  postTitle    String
  categorySlug String
  authorName   String?
  readAt       DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postSlug])
  @@index([postSlug])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postSlug  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postSlug])
  @@index([postSlug])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  postSlug     String
  postTitle    String
  categorySlug String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, postSlug])
  @@index([postSlug])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postSlug  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postSlug])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthorCV {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String?
  tagline    String?
  bio        String?  @db.Text
  location   String?
  email      String?
  phone      String?
  website    String?
  linkedin   String?
  github     String?
  twitter    String?
  avatarUrl  String?
  education  Json     @default("[]")
  experience Json     @default("[]")
  skills     Json     @default("[]")
  references     Json     @default("[]")
  languages      Json     @default("[]")
  projects       Json     @default("[]")
  certifications Json     @default("[]")
  honors         Json     @default("[]")
  birthYear      String?
  sectionVisibility Json     @default("{}")
  isPublic       Boolean  @default(false)
  slug       String?  @unique
  // CV Designer fields
  designGenerationsUsed  Int   @default(0)
  designHistory          Json  @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostView {
  id       String   @id @default(cuid())
  postSlug String
  viewedAt DateTime @default(now())

  @@index([postSlug])
  @@index([viewedAt])
}

enum Role {
  ADMIN
  AUTHOR
  SUBSCRIBER
}

enum AuthorStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthorApiKey {
  id         String    @id @default(cuid())
  userId     String    @unique
  keyHash    String    @unique
  keyHint    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  activity     String
  model        String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activity])
  @@index([createdAt])
}

model GuideCompletion {
  id          String   @id @default(cuid())
  userId      String
  guideSlug   String
  score       Int      @default(0)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guideSlug])
  @@index([userId])
  @@index([guideSlug])
}

// ── Visual Guides curriculum ──────────────────────────────────────────────

enum GuideVisibility {
  DRAFT
  PUBLISHED
  HIDDEN
}

model GuideCategory {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String?         @db.Text
  color       String
  order       Int
  visibility  GuideVisibility @default(DRAFT)
  units       GuideUnit[]
  guides      VisualGuide[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([order])
}

model GuideUnit {
  id         String          @id @default(cuid())
  slug       String          @unique
  name       String
  order      Int
  categoryId String
  visibility GuideVisibility @default(DRAFT)
  category   GuideCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  guides     VisualGuide[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([categoryId, order])
  @@index([categoryId])
}

model VisualGuide {
  id              String          @id @default(cuid())
  slug            String          @unique
  title           String
  description     String          @db.Text
  interactiveType String
  audience        String          @default("Everyone")
  order           Int
  visibility      GuideVisibility @default(DRAFT)
  implemented     Boolean         @default(false)
  categoryId      String
  unitId          String?
  nextGuideSlug   String?
  category        GuideCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  unit            GuideUnit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([categoryId, order])
  @@index([categoryId])
  @@index([unitId])
  @@index([visibility])
}

model SharedPdf {
  id           String           @id @default(cuid())
  token        String           @unique
  title        String
  blobUrl      String
  blobPathname String
  sizeBytes    Int
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  events       SharedPdfEvent[]
}

model SharedPdfEvent {
  id          String             @id @default(cuid())
  sharedPdfId String
  type        SharedPdfEventType
  at          DateTime           @default(now())
  sharedPdf   SharedPdf          @relation(fields: [sharedPdfId], references: [id], onDelete: Cascade)

  @@index([sharedPdfId])
  @@index([at])
}

enum SharedPdfEventType {
  VIEW
  DOWNLOAD
}

/// Derived semantic-search index over published posts + research files.
/// Rebuildable by nnx-search-mcp; written only via raw SQL, never Prisma client.
model ContentEmbedding {
  id          String   @id
  sourceType  String
  sourceId    String
  chunkIndex  Int
  title       String
  url         String?
  content     String   @db.Text
  contentHash String
  embedding   Unsupported("extensions.vector(768)")
  updatedAt   DateTime @default(now())

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType])
}
